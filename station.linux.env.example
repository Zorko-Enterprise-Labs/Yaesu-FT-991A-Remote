# Linux example. setup_station.py generates the real station.env.
FT991_PLATFORM=linux
FT991_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
FT991_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
FT991_HTTPS=1
FT991_DEBUG=0
FT991_ALLOW_INSECURE_HTTP=0
FT991_HOST=0.0.0.0
FT991_PORT_HTTP=5000
FT991_PORT=/dev/ttyUSB0
FT991_BAUD=38400
